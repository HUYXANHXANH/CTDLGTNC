#include <iostream>
#include <string>
#include <iomanip>

using namespace std;

// ==========================================
// CÂU 1: ĐỊNH NGHĨA CẤU TRÚC HÀNG HÓA
// ==========================================
struct NgayThang {
    int ngay;
    int thang;
    int nam;
};

struct HangHoa {
    string maHang;
    string tenHang;
    NgayThang ngayXuat;
    double giaXuat; // Đơn vị: triệu đồng
};

// ==========================================
// CÂU 2: HÀM NHẬP MẢNG N HÀNG HÓA
// ==========================================
void nhapMotHangHoa(HangHoa &hh) {
    cout << "  - Nhap ma hang hoa: ";
    getline(cin >> ws, hh.maHang);
    
    cout << "  - Nhap ten hang hoa: ";
    getline(cin, hh.tenHang);
    
    cout << "  - Nhap ngay xuat (ngay thang nam, cach nhau boi dau cach): ";
    cin >> hh.ngayXuat.ngay >> hh.ngayXuat.thang >> hh.ngayXuat.nam;
    
    cout << "  - Nhap gia xuat hang (trieu dong): ";
    cin >> hh.giaXuat;
}

void nhapDanhSach(HangHoa a[], int n) {
    for (int i = 0; i < n; i++) {
        cout << "\n--- Nhap thong tin hang hoa thu " << i + 1 << " ---" << endl;
        nhapMotHangHoa(a[i]);
    }
}

// ==========================================
// CÂU 3: HÀM XUẤT MẢNG N HÀNG HÓA
// ==========================================
void inTieuDe() {
    cout << left 
         << setw(12) << "Ma HH" 
         << setw(25) << "Ten hang hoa" 
         << setw(15) << "Ngay xuat" 
         << right << setw(15) << "Gia (trieu d)" 
         << endl;
    cout << string(67, '-') << endl;
}

void xuatMotHangHoa(const HangHoa &hh) {
    // Dinh dang chuoi ngay/thang/nam
    string ngayStr = to_string(hh.ngayXuat.ngay) + "/" + 
                     to_string(hh.ngayXuat.thang) + "/" + 
                     to_string(hh.ngayXuat.nam);

    cout << left 
         << setw(12) << hh.maHang 
         << setw(25) << hh.tenHang 
         << setw(15) << ngayStr 
         << right << setw(15) << fixed << setprecision(2) << hh.giaXuat 
         << endl;
}

void xuatDanhSach(HangHoa a[], int n) {
    inTieuDe();
    for (int i = 0; i < n; i++) {
        xuatMotHangHoa(a[i]);
    }
}

// ==========================================
// CÂU 4: SẮP XẾP QUICK SORT TĂNG DẦN THEO GIÁ
// ==========================================
void hoanVi(HangHoa &x, HangHoa &y) {
    HangHoa temp = x;
    x = y;
    y = temp;
}

int phanHoach(HangHoa a[], int left, int right) {
    double pivot = a[right].giaXuat; // Chon phan tu cuoi lam chot
    int i = left - 1;

    for (int j = left; j < right; j++) {
        if (a[j].giaXuat <= pivot) {
            i++;
            hoanVi(a[i], a[j]);
        }
    }
    hoanVi(a[i + 1], a[right]);
    return i + 1;
}

void quickSort(HangHoa a[], int left, int right) {
    if (left < right) {
        int pi = phanHoach(a, left, right);
        quickSort(a, left, pi - 1);
        quickSort(a, pi + 1, right);
    }
}

// ==========================================
// CÂU 5: TÌM KIẾM NHỊ PHÂN HÀNG HÓA CÓ GIÁ BẰNG X
// ==========================================
// Ham tim kiem mot vi tri bat ky co giaXuat == X
int binarySearch(HangHoa a[], int left, int right, double x) {
    if (left <= right) {
        int mid = left + (right - left) / 2;

        if (a[mid].giaXuat == x) {
            return mid;
        }
        if (a[mid].giaXuat > x) {
            return binarySearch(a, left, mid - 1, x);
        }
        return binarySearch(a, mid + 1, right, x);
    }
    return -1;
}

// Ham mo rong de hien thi TAT CA cac hang hoa co cung gia X
void timKiemVaHienThiTheoGia(HangHoa a[], int n, double x) {
    int viTri = binarySearch(a, 0, n - 1, x);

    if (viTri == -1) {
        cout << "Khong tim thay hang hoa nao co gia xuat bang " << x << " trieu dong." << endl;
        return;
    }

    // Do mang da sap xep, cac phan tu co cung gia se nam lien tiep nhau
    int batDau = viTri;
    while (batDau > 0 && a[batDau - 1].giaXuat == x) {
        batDau--;
    }

    int ketThuc = viTri;
    while (ketThuc < n - 1 && a[ketThuc + 1].giaXuat == x) {
        ketThuc++;
    }

    cout << "\nTim thay cac hang hoa co gia bang " << x << " trieu dong:\n";
    inTieuDe();
    for (int i = batDau; i <= ketThuc; i++) {
        xuatMotHangHoa(a[i]);
    }
}

// ==========================================
// CÂU 6: HÀM CHÍNH (MAIN)
// ==========================================
int main() {
    int n;
    cout << "Nhap so luong hang hoa: ";
    cin >> n;

    if (n <= 0) {
        cout << "So luong hang hoa khong hop le!" << endl;
        return 0;
    }

    HangHoa *a = new HangHoa[n];

    // 1. Nhập và xuất danh sách ban đầu
    nhapDanhSach(a, n);
    cout << "\n==============================================" << endl;
    cout << "DANH SACH HANG HOA VUA NHAP:" << endl;
    xuatDanhSach(a, n);

    // 2. Sắp xếp danh sách theo Quick Sort
    quickSort(a, 0, n - 1);
    cout << "\n==============================================" << endl;
    cout << "DANH SACH SAU KHI SAP XEP TANG DAN THEO GIA (QUICK SORT):" << endl;
    xuatDanhSach(a, n);

    // 3. Tìm kiếm hàng hóa theo giá X
    double x;
    cout << "\n==============================================" << endl;
    cout << "Nhap gia xuat hang X can tim (trieu dong): ";
    cin >> x;
    timKiemVaHienThiTheoGia(a, n, x);

    // Giai phong bo nho
    delete[] a;

    return 0;
}
